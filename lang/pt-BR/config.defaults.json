{
  "$schema": "https://raw.githubusercontent.com/aleckyann/brain-kit/main/schema/config.schema.json",
  "kit_version": "0.0.2",
  "lang": "pt-BR",
  "okf_version": "0.2",
  "owner": {
    "name": "<owner-name>",
    "handle": "<owner-handle>",
    "email": "<owner-email>",
    "role": null,
    "company": null,
    "agent_role": "conselheiro e chefe de gabinete"
  },
  "vault": {
    "title": "<vault-title>",
    "repo": "<vault-repo>",
    "private": true,
    "default_branch": null,
    "timezone": "<vault-timezone>",
    "locale": "pt_BR.UTF-8"
  },
  "actors": {
    "human": "human:<owner-handle>",
    "agent_prefix": "brain-kit-curator",
    "scheduled": "process:brain-kit-curate"
  },
  "taxonomy": {
    "collections": {
      "pessoas": {
        "type": "person",
        "template": "templates/modelo-pessoa.md"
      },
      "organizacoes": {
        "type": "organization",
        "template": "templates/modelo-organizacao.md"
      },
      "projetos": {
        "type": "project",
        "template": "templates/modelo-projeto.md"
      },
      "decisoes": {
        "type": "decision",
        "template": "templates/modelo-decisao.md",
        "filename_pattern": "YYYY-MM-<slug>"
      },
      "reflexoes": {
        "type": "reflection",
        "template": "templates/modelo-reflexao.md"
      },
      "referencias/livros": {
        "type": "book",
        "template": "templates/modelo-livro.md"
      }
    },
    "domains": [
      "nucleo",
      "memoria",
      "pendencias"
    ],
    "no_index": [],
    "log": "memoria/log.md",
    "log_markers": {
      "capture": "Captura",
      "promoted": "Promovido",
      "correction": "Correção",
      "creation": "Criação"
    },
    "templates_dir": "templates",
    "attachments_dir": "anexos",
    "files": {
      "followups": "pendencias/acompanhamentos.md",
      "promises": "pendencias/promessas.md",
      "rituals": "nucleo/ritmo-semanal.md",
      "execution_system": null,
      "style_guide": "nucleo/diretrizes-de-resposta.md",
      "bootstrap": null,
      "strategy_index": "decisoes/index.md",
      "metrics": null,
      "glossary": null
    },
    "columns": {
      "followups": {
        "columns": [
          "Registrado",
          "O que",
          "Com quem / onde",
          "Prazo",
          "Próximo passo"
        ],
        "labels": {
          "open_heading": "## Abertos",
          "resolved_heading": "## Resolvidos"
        }
      },
      "promises": {
        "columns": [
          "Feita em",
          "Para quem",
          "O que prometi",
          "Condição / prazo",
          "Situação"
        ],
        "labels": {
          "active_heading": "## Ativas",
          "done_heading": "## Cumpridas / renegociadas"
        }
      },
      "rituals": {
        "columns": [
          "Título no calendário",
          "Cadência",
          "Horário",
          "Dono",
          "Participantes fixos",
          "Alimenta"
        ],
        "labels": {
          "feeds_none": "nenhuma ainda"
        }
      }
    }
  },
  "frontmatter": {
    "required": [
      "description",
      "generated"
    ],
    "forbidden": [
      "timestamp"
    ],
    "type_enum": null,
    "extensions": {
      "confidencial": {
        "type": "boolean",
        "default": false
      },
      "situacao": {
        "type": "enum",
        "values_by_type": {
          "decision": [
            "aberta",
            "em-execucao",
            "concluida",
            "revertida"
          ],
          "project": [
            "ativo",
            "ideia",
            "adiado",
            "concluido",
            "arquivado"
          ]
        }
      },
      "vinculo": {
        "type": "enum",
        "values": [
          "equipe",
          "familia",
          "mentor",
          "externo"
        ],
        "default": "equipe"
      },
      "autor": {
        "type": "string"
      },
      "lido": {
        "type": "string"
      },
      "data": {
        "type": "date"
      },
      "idioma": {
        "type": "string"
      }
    }
  },
  "stale_policy": {
    "key": "path",
    "months": {
      "pessoas/": 6,
      "organizacoes/": 12,
      "pendencias/": 3
    }
  },
  "validate": {
    "link_style": "file-relative",
    "wikilinks": "forbid",
    "require_root_okf_version": true,
    "placeholder_pattern": "<[^>]+>",
    "ignore_paths": [],
    "timestamp_deviation": "forbid"
  },
  "lint": {
    "columns": "error",
    "tables": {
      "severity": "error",
      "max_cell_chars": 600,
      "duplicate_rows": "error"
    },
    "orphans": "warn",
    "index_completeness": "warn",
    "secrets": "error",
    "privacy": "error",
    "attribution": "warn",
    "style": {
      "severity": "warn",
      "forbidden_chars": [
        "\u2014"
      ]
    }
  },
  "privacy": {
    "confidential_dirs": [
      "pessoas/"
    ],
    "confidential_field": "confidencial",
    "require_private_repo": true,
    "secret_patterns": [
      "-----BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY-----",
      "ghp_[A-Za-z0-9]{20,}",
      "github_pat_[A-Za-z0-9_]{20,}",
      "sk-ant-[A-Za-z0-9_-]{10,}",
      "AKIA[0-9A-Z]{16}",
      "xox[baprs]-[A-Za-z0-9-]{10,}"
    ],
    "third_party_keywords": [
      "consulta médica",
      "atestado médico",
      "licença médica",
      "teleconsulta",
      "sessão de terapia",
      "exame médico",
      "internação",
      "gravidez"
    ],
    "keyword_exempt_paths": [],
    "third_party_data_acknowledged": false,
    "retention_note": "pessoas/ contém dados pessoais de terceiros; remoção a pedido: veja SECURITY.md",
    "audiences": {}
  },
  "git": {
    "agent_identity": {
      "name": "<vault-title> (curador)",
      "email": "curador@example.invalid"
    },
    "branch_prefix": "curador/",
    "commit_prefix": "curadoria:",
    "pr_command": "gh",
    "pr_title": "{{commit_prefix}} {{summary}}",
    "pr_body": ".brain-kit/pr-body.md",
    "ci": "github-actions",
    "ci_engine_ref": null,
    "forbid_agent_push_to_default": true
  },
  "hooks": {
    "stop": true,
    "session_start": true,
    "session_start_fetch": false,
    "block_on_inherited_dirt": false,
    "timeout_seconds": 15
  },
  "curate": {
    "enabled": true,
    "schedule": [
      "09:30",
      "14:00",
      "20:00"
    ],
    "prompt": ".brain-kit/prompts/curate.md",
    "signature": "Curador do segundo cérebro",
    "max_turns": 100,
    "budget_usd": 5,
    "timeout_minutes": null,
    "network_min_wait_ms": 100,
    "caps": {
      "transcripts": 20,
      "search_docs_opened": 3,
      "attached_notes_opened": 6,
      "new_pending_items": 5
    },
    "promotion_map": {
      "owner_action": "pendencias/acompanhamentos.md",
      "owner_promise": "pendencias/promessas.md",
      "third_party_strategic": "pendencias/acompanhamentos.md",
      "third_party_operational": "log-only",
      "strategic_decision": "decisoes/",
      "decision_needs_talk": "pendencias/acompanhamentos.md",
      "person_fact": "pessoas/",
      "ritual_change": "nucleo/ritmo-semanal.md"
    },
    "sources": {
      "required": [
        "transcripts"
      ],
      "best_effort": [
        "calendar",
        "meeting_notes"
      ]
    },
    "extra_signatures": [],
    "allowed_tools_extra": [],
    "disallowed_tools_extra": []
  },
  "sources": {
    "transcripts": {
      "adapter": "claude-code",
      "include_projects": [],
      "exclude_path_patterns": [
        "/-tmp-",
        "/-scratch-"
      ],
      "sample_strategy": "tail-first"
    },
    "calendar": {
      "enabled": false,
      "provider": "claude-connector-google-calendar",
      "server_display_name": "claude.ai Google Calendar",
      "tool_prefix": "mcp__claude_ai_Google_Calendar__",
      "tool_suffixes": [
        "list_events",
        "get_event",
        "list_calendars"
      ],
      "calendars": [],
      "team_calendars": [],
      "team_calendars_consent_noted": false,
      "skip_events_with_owner": true,
      "dedup_by": "eventId",
      "privacy": {
        "exclude_event_types": [
          "OUT_OF_OFFICE",
          "FOCUS_TIME"
        ],
        "exclude_keywords": [
          "pessoal"
        ],
        "team_personal_events": "drop"
      },
      "focus_blocks_as_ruler": true
    },
    "meeting_notes": {
      "enabled": false,
      "provider": "claude-connector-google-drive",
      "server_display_name": "claude.ai Google Drive",
      "tool_prefix": "mcp__claude_ai_Google_Drive__",
      "tool_suffixes": [
        "search_files",
        "read_file_content",
        "get_file_metadata"
      ],
      "search_title_contains": "Anotações do Gemini",
      "attached_title_prefix": "",
      "window_hours_before_day": 12,
      "dedup_by": "literal-title-in-log",
      "never_download": [
        "recording",
        "full_transcript"
      ]
    }
  },
  "briefing": {
    "enabled": true,
    "schedule": "0 9 * * 1-5",
    "prompt": ".brain-kit/prompts/briefing.md",
    "signature": "Briefing matinal do segundo cérebro",
    "max_words": null,
    "max_questions": null,
    "questions_dedup_days": 15,
    "question_escalate_after": 3,
    "question_max_age_days": 45,
    "write_caps": {
      "captures": null,
      "pending_changes": null
    },
    "strategy_doc": {
      "index": "decisoes/index.md",
      "title_contains": "carta"
    },
    "calendar_id": "<owner-email>",
    "read": [
      "index.md",
      "AGENTS.md",
      "decisoes/index.md",
      "pendencias/promessas.md",
      "projetos/index.md",
      "nucleo/ritmo-semanal.md"
    ],
    "never_read": [
      "pessoas/",
      "anexos/",
      ".brain-kit/",
      "memoria/log.md#inteiro"
    ],
    "upcoming_days": 7,
    "blocks": ["sources", "due", "upcoming", "undated", "open_prs", "stale", "blind_spots", "strategy", "questions"],
    "pending": [
      { "file": "followups", "heading": "open_heading", "date_column": "Prazo", "what_column": "O que" },
      { "file": "promises", "heading": "active_heading", "date_column": "Condição / prazo", "what_column": "O que prometi" }
    ]
  }
}
