#!/usr/bin/env bash
# brain-kit maintainer pre-push gate: refuse to push anything that looks like a
# secret or like household data (the maintainer's company, colleagues, clients).
#
# Why a pre-push and not CI: CI runs after the push, when the content is already
# in the public history of the repository. This hook runs before anything
# leaves the machine.
#
# Personal patterns live OUTSIDE the repository, one extended regex per line,
# because the list of names to protect is itself the data to protect:
#   default file: ~/.config/brain-kit/leak-patterns.txt
#   override:     BRAIN_KIT_LEAK_PATTERNS=/path/to/file
# The hook fails closed: no patterns file, no push.
#
# Portability: bash 3.2 and a POSIX userland. The project's own CI runs this on
# macOS, whose /bin/bash is 3.2.57 and whose grep, sort and tr are BSD, so
# nothing here may need bash 4 (no associative arrays, no ${var,,}) or a
# GNU-only flag. The flags relied on are `grep -a`, `grep -m`, `sort -z` and
# `tr -d`, all present in both userlands, and every empty-array expansion uses
# the ${arr[@]+"${arr[@]}"} form, which old bash needs under `set -u`.
#
# Activate once per clone:  git config core.hooksPath .githooks
set -u

# 18/09/2026, fourth lesson: three gaps, all the same shape. A scanner that
# could not see something shrugged instead of refusing.
#   (a) Merge commits were never scanned. `git diff-tree` on a commit with
#       more than one parent prints nothing at all by default, so a merge
#       whose conflict resolution typed in a secret that exists in neither
#       parent went out unexamined, with no force and no adversarial setup.
#       Fixed with `-m`, which emits one diff per parent: a path whose blob
#       differs from ANY parent is listed, which is a superset of everything
#       the merge itself introduced. A path identical to every parent is not
#       new in the merge, and that content was already covered when those
#       parents were scanned, or is already public on the remote. Paths repeat
#       across the per-parent diffs, so they are deduped per commit.
#   (b) Binary-flagged blobs were skipped. `grep -I` answers "no match" for
#       any blob it considers binary, so a single NUL byte anywhere in a file
#       hid every secret in it. Fixed with `-a`: such a blob is scanned as
#       text. Capping how much is PRINTED never changes what is REFUSED.
#   (c) The patterns file was accepted when it was useless, and grep's errors
#       were swallowed. `-r` alone accepts a directory and a zero-byte file,
#       so the personal patterns silently disappeared while the hook went on
#       reporting success; and `scan_blob`'s trailing `|| true` erased the
#       difference between grep's three outcomes (0 matched, 1 nothing
#       matched, above 1 grep itself failed, e.g. an invalid regex in the
#       patterns file). Both are explicit now: a regular, readable, non-empty
#       file or no push, and any grep status above 1 refuses the push naming
#       the file and the status.
#
# 18/09/2026, fifth lesson: four more, the last two about the machine the hook
# runs on rather than about git.
#   (d) Typechanges were dropped. `--diff-filter=AM` names what to KEEP, and
#       git has more letters than A and M: replacing a symlink with a regular
#       file carrying a secret is a `T`, which was excluded, so it reached the
#       remote unscanned with exit 0 and no warning. An allow-list of change
#       kinds is a blind spot by construction. The filter is inverted now:
#       `--diff-filter=d`, lower case, excludes deletions and keeps everything
#       else, so additions, modifications, typechanges, copies and renames are
#       all scanned. Deletions are the only kind with nothing to read.
#   (e) Only the last stage's status was read. The scan is a pipeline,
#       `git show | tr | grep`, and `$?` reports grep alone. A `git show` that
#       fails (a gitlink whose commit this clone does not have exits 128) or a
#       `tr` that dies feeds grep an empty stream, grep says "nothing matched",
#       and a file nobody could read was called clean. Every stage's status is
#       inspected through PIPESTATUS now. The order matters: grep's own verdict
#       is read first, because `-m` makes grep close the pipe early on a match
#       and the upstream stages then report SIGPIPE (141), which is expected
#       and says nothing about the blob. Upstream failures are what turns an
#       otherwise clean verdict into a refusal.
#   (f) The hook required bash 4. The dedupe used an associative array and
#       `"${remote_exclusions[@]}"` aborts on an empty array under `set -u` in
#       old bash, so on macOS (bash 3.2.57) the dedupe silently switched off
#       and the very first push died on an unbound variable. A gate that
#       behaves differently, or not at all, on the machine its users have is
#       not a gate. The dedupe is `sort -zu` now, which keeps the NUL
#       discipline and needs no shell features, the exclusions use the
#       ${arr[@]+"${arr[@]}"} form, and the bash-version detection is gone:
#       there is no version-dependent behaviour left to detect.
#   (g) The locale could abort the scan. BSD `tr` and `grep` in a UTF-8 locale
#       can fail on an invalid byte sequence, which is exactly what a binary
#       blob is full of, and with (e) that abort read as a clean file. The
#       scanning pipeline forces LC_ALL=C, so every stage treats input as
#       bytes. The patterns are ASCII, with no locale-dependent character
#       class, so no existing match changes.
PATTERNS_FILE="${BRAIN_KIT_LEAK_PATTERNS:-$HOME/.config/brain-kit/leak-patterns.txt}"
if [ ! -e "$PATTERNS_FILE" ]; then
  echo "pre-push: leak patterns file not found: $PATTERNS_FILE" >&2
  echo "pre-push: create it (one extended regex per line) or point BRAIN_KIT_LEAK_PATTERNS at it. Refusing to push." >&2
  exit 1
fi
if [ ! -f "$PATTERNS_FILE" ]; then
  echo "pre-push: leak patterns file is not a regular file: $PATTERNS_FILE" >&2
  echo "pre-push: it must be a plain file with one extended regex per line. Refusing to push." >&2
  exit 1
fi
if [ ! -r "$PATTERNS_FILE" ]; then
  echo "pre-push: leak patterns file is not readable: $PATTERNS_FILE" >&2
  echo "pre-push: fix its permissions, or point BRAIN_KIT_LEAK_PATTERNS at a readable file. Refusing to push." >&2
  exit 1
fi
if [ ! -s "$PATTERNS_FILE" ]; then
  echo "pre-push: leak patterns file is empty: $PATTERNS_FILE" >&2
  echo "pre-push: an empty file protects nothing while looking like it does. Write one extended regex per line. Refusing to push." >&2
  exit 1
fi

# Generic patterns, versioned here because they name no one: private keys and
# well-known token prefixes.
GENERIC_PATTERNS='-----BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY-----|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-ant-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'

ZERO='0000000000000000000000000000000000000000'
failed=0

# Scratch files. The scanning pipeline has to run in this shell, not inside a
# command substitution, so that PIPESTATUS can be read for every stage (fifth
# lesson, (e)); its output therefore goes to a file. `mktemp -d` with an
# explicit template behaves the same in GNU and BSD userlands. Failing to
# create it refuses the push: no scratch space, no scan.
if ! TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/brain-kit-prepush.XXXXXX")"; then
  echo "pre-push: could not create a temporary directory; refusing to push." >&2
  exit 1
fi
trap 'rm -rf "$TMP_DIR"' EXIT
PATHS_RAW="$TMP_DIR/paths.raw"
PATHS_FILE="$TMP_DIR/paths"
HITS_FILE="$TMP_DIR/hits"

# 18/09/2026: a ref the remote does not have yet (remote_sha = zero) used to
# scan `git rev-list "$local_sha"`, the entire history. That is right for a
# brand new repository's first push, but wrong for any later new ref: pushing
# the release tag v0.0.1, which points at an already-published commit, made
# this re-scan all history and refuse the push over a fixture that lives in
# commits already public on the remote. Re-scanning published commits
# protects nothing and blocks routine pushes.
#
# 18/09/2026, second lesson: the first fix scoped every ref, new or update, to
# `--not --remotes=origin`, trusting the local refs/remotes/origin/* tracking
# refs as a stand-in for what the remote has. Those tracking refs are only a
# cache, last written by this clone's own previous push or fetch. A remote
# rewound or rewritten from another clone can leave that cache claiming
# commits the remote does not hold any more, and excluding by it would let a
# leak inside one of those commits reach the remote unscanned. Only two
# sources are authoritative, because both come from asking the remote itself,
# right now: the live push negotiation git already ran for us (the remote_sha
# on stdin, for a ref the remote already has) and a live `git ls-remote`
# against the remote (for a ref the remote does not have yet). The tracking
# refs are never trusted for exclusion again. `query_remote` below runs that
# `ls-remote` at most once per hook invocation, so a push carrying several new
# refs (e.g. `git push --tags`) does not repeat the network call. If the
# remote cannot be reached to ask, fail closed: scan the whole history rather
# than assume it is safe to skip anything.
remote_name="${1:-origin}"
remote_queried=0
remote_reachable=0
remote_exclusions=()

query_remote() {
  [ "$remote_queried" -eq 1 ] && return 0
  remote_queried=1
  local raw sha ref resolved
  if ! raw="$(git ls-remote --heads --tags "$remote_name" 2>/dev/null)"; then
    remote_reachable=0
    return 0
  fi
  remote_reachable=1
  while IFS=$'\t' read -r sha ref; do
    [ -z "$sha" ] && continue
    resolved="$(git rev-parse -q --verify "${sha}^{commit}" 2>/dev/null)"
    if [ -z "$resolved" ]; then
      resolved="$(git rev-parse -q --verify "${sha}^{}" 2>/dev/null)"
    fi
    [ -n "$resolved" ] && remote_exclusions+=("^$resolved")
  done <<< "$raw"
}

# At most this many matching lines are printed per file, because a binary blob
# scanned as text can match on lines that are megabytes wide. This caps the
# message, never the verdict: one hit already refuses the push.
MAX_HITS=5

scan_blob() {
  # $1 = commit sha, $2 = path. Prints "line: match" for every hit, capped.
  local sha="$1" path="$2" show_status tr_status grep_status
  # `-a` instead of `-I`: a blob git or grep considers binary is scanned as
  # text rather than waved through (fourth lesson, (b)). NULs are stripped
  # before grep and not after, which keeps line numbering intact (a NUL is not
  # a newline), keeps the output free of bytes the shell would drop with a
  # warning, and can only make a pattern match more readily, never less. `-m`
  # stops grep at the print cap instead of reading a whole binary. LC_ALL=C
  # makes every stage byte-oriented (fifth lesson, (g)).
  LC_ALL=C git show "$sha:$path" 2>/dev/null \
    | LC_ALL=C tr -d '\000' \
    | LC_ALL=C grep -n -a -i -E -m "$MAX_HITS" -f "$PATTERNS_FILE" -e "$GENERIC_PATTERNS" > "$HITS_FILE"
  # The whole array at once: any command after the pipeline, an assignment
  # included, overwrites PIPESTATUS.
  pipe_status=("${PIPESTATUS[@]}")
  show_status="${pipe_status[0]}"
  tr_status="${pipe_status[1]}"
  grep_status="${pipe_status[2]}"

  if [ "$grep_status" -gt 1 ]; then
    # grep did not say "clean", it said nothing at all: an invalid regex in
    # the patterns file, an I/O error, a patterns file it could not read.
    # Swallowing this with `|| true` is exactly how a scanner shrugs.
    failed=1
    echo "pre-push: could not scan $path (at ${sha:0:7}): grep exited $grep_status (patterns file: $PATTERNS_FILE)." >&2
    return 0
  fi

  if [ "$grep_status" -eq 0 ]; then
    # A hit. The upstream stages may report SIGPIPE (141) right here, because
    # `-m` made grep stop reading early; that is expected and says nothing
    # about the blob, and the verdict is already "refuse".
    failed=1
    echo "pre-push: possible leak in $path (at ${sha:0:7}):" >&2
    # Truncate each printed line and drop control bytes, so a match inside a
    # binary blob stays readable in a terminal. Bytes above 0x7f are left
    # alone, so ordinary accented text survives.
    LC_ALL=C cut -b 1-200 < "$HITS_FILE" \
      | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' \
      | sed 's/^/    /' >&2
    return 0
  fi

  # grep read the whole stream and matched nothing. That verdict is only worth
  # something if every stage before it actually ran (fifth lesson, (e)).
  if [ "$show_status" -ne 0 ]; then
    failed=1
    echo "pre-push: could not read $path (at ${sha:0:7}): git show exited $show_status; refusing instead of calling it clean." >&2
    return 0
  fi
  if [ "$tr_status" -ne 0 ]; then
    failed=1
    echo "pre-push: could not read $path (at ${sha:0:7}): tr exited $tr_status; refusing instead of calling it clean." >&2
    return 0
  fi
  return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion: nothing to scan

  if [ "$remote_sha" != "$ZERO" ]; then
    # The remote already has this ref, and git just told us so, live, as part
    # of this very push negotiation. Scan exactly what is new since then.
    #
    # 18/09/2026, third lesson: remote_sha is authoritative about what the
    # remote has, but that says nothing about what THIS clone has. A clone
    # that is stale-behind (another clone pushed, or force-pushed, without
    # this one ever fetching) can be asked to range over a remote_sha whose
    # object it does not possess at all. `git rev-list A..B` then fails
    # ("Invalid revision range") with empty stdout, which used to look
    # exactly like "nothing to scan": the loop below ran zero times, `failed`
    # stayed 0, and the push went through completely unscanned. An empty
    # result must never be read as "safe"; only a range that actually
    # computed is. Capture the exit status and fail closed into a full scan
    # when the range itself could not be computed.
    if ! commits="$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)"; then
      echo "pre-push: the remote's reported commit for $local_ref ($remote_sha) is unknown to this clone; scanning the entire history of $local_ref instead of trusting that range." >&2
      commits="$(git rev-list "$local_sha")"
    fi
  else
    # A ref the remote does not have yet: ask the remote directly what it
    # holds (once per hook run) instead of trusting the local tracking refs.
    query_remote
    if [ "$remote_reachable" -eq 1 ]; then
      # The ${arr[@]+"${arr[@]}"} form, not "${arr[@]}": an empty array under
      # `set -u` aborts the script in bash 3.2 (fifth lesson, (f)).
      commits="$(git rev-list "$local_sha" ${remote_exclusions[@]+"${remote_exclusions[@]}"})"
    else
      echo "pre-push: could not query remote '$remote_name' (git ls-remote failed); scanning the entire history of $local_ref instead of trusting the local tracking refs." >&2
      commits="$(git rev-list "$local_sha")"
    fi
  fi

  while IFS= read -r commit; do
    [ -z "$commit" ] && continue
    if git rev-parse -q --verify "$commit^" >/dev/null 2>&1; then
      # `-m` (fourth lesson, (a)): without it a merge commit diffs to nothing
      # and is never scanned. With it diff-tree emits one diff per parent, so
      # any path differing from any parent is listed, and the dedupe below
      # keeps a path from being scanned once per parent. Some git versions
      # also print the commit id as a field of its own here despite
      # --no-commit-id; that is harmless, because `git show <sha>:<that id>`
      # resolves to nothing, and it can never hide a real path.
      #
      # `--diff-filter=d` (fifth lesson, (d)): exclude deletions, keep every
      # other kind of change, typechanges included.
      git diff-tree -m -r -z --no-commit-id --name-only --diff-filter=d "$commit" > "$PATHS_RAW"
    else
      # Root commit: it has no parent to diff against, so every file it
      # introduces is new to the remote.
      git ls-tree -r -z --name-only "$commit" > "$PATHS_RAW"
    fi
    list_status=$?
    if [ "$list_status" -ne 0 ]; then
      failed=1
      echo "pre-push: could not list the files of $commit (git exited $list_status); refusing instead of scanning nothing." >&2
      continue
    fi

    # Dedupe without an associative array (fifth lesson, (f)). `sort -zu`
    # keeps the NUL separation, so paths with spaces or newlines survive. The
    # dedupe is an optimisation, not a safety property: if sort cannot do it,
    # scan the raw list instead, duplicates included. Noisier, never blinder.
    if ! LC_ALL=C sort -zu < "$PATHS_RAW" > "$PATHS_FILE" 2>/dev/null; then
      cat "$PATHS_RAW" > "$PATHS_FILE"
    elif [ -s "$PATHS_RAW" ] && [ ! -s "$PATHS_FILE" ]; then
      cat "$PATHS_RAW" > "$PATHS_FILE"
    fi

    while IFS= read -r -d '' path; do
      [ -z "$path" ] && continue
      scan_blob "$commit" "$path"
    done < "$PATHS_FILE"
  done <<< "$commits"
done

if [ "$failed" -ne 0 ]; then
  echo "pre-push: push refused. Remove the flagged content (and rewrite the commits that contain it) before pushing." >&2
  exit 1
fi
exit 0
